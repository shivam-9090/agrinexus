# Copy to .env to override defaults. Nothing here is required to run
# locally -- every value has a safe default (see app/config.py).

LOG_LEVEL=INFO

# Rate limiting (defaults: enabled, 120 requests/60s per client IP)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

# Unset by default: federation POST endpoints accept writes from anyone.
# Set this to require a matching X-API-Key header on writes -- and set
# VITE_FEDERATION_API_KEY to the same value in frontend/.env so the app's
# own "register a node" / "publish an insight" forms keep working.
FEDERATION_API_KEY=
